<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GoWorkBro" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg_dark</item>
        <item name="android:statusBarColor">@color/splash_bg_dark</item>
        <item name="android:navigationBarColor">@color/splash_bg_dark</item>
    </style>

    <style name="Theme.GoWorkBro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_sprout</item>
        <item name="postSplashScreenTheme">@style/Theme.GoWorkBro</item>
    </style>
</resources>
