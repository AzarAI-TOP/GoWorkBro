# GoWorkBro — Development Environment Configuration
#
# 1. Create lib/services/local_config.dart with your Supabase credentials:
#    const String localSupabaseUrl = 'https://your-project.supabase.co';
#    const String localSupabaseAnonKey = 'your-publishable-key';
#
# 2. Run: bash dev.sh  (reads local_config.dart, passes via --dart-define)
#
# 3. Set up Supabase database: run supabase/schema.sql in Supabase SQL Editor
#
# For CI/CD, pass credentials directly:
#   flutter build --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...
#
# NOTE: local_config.dart is gitignored — never commit credentials.
