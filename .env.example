# GoWorkBro 开发环境配置
#
# 1. 复制此文件为 lib/services/local_config.dart
# 2. 填入你的 Supabase 凭据
# 3. local_config.dart 已被 .gitignore 排除，不会提交到 GitHub
#
# 或者使用 --dart-define 方式（推荐用于 CI/CD）:
#   flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=...

# lib/services/local_config.dart 内容:
# const String localSupabaseUrl = 'https://your-project.supabase.co';
# const String localSupabaseAnonKey = 'your-publishable-key';
